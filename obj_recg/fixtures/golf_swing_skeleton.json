{
  "description": "COCO 17-keypoint person layout used to draw limb lines on a golf swing. Mirror of src/uplevels_cv/skeleton.py.",
  "keypoint_names": [
    "nose", "left_eye", "right_eye", "left_ear", "right_ear",
    "left_shoulder", "right_shoulder", "left_elbow", "right_elbow",
    "left_wrist", "right_wrist", "left_hip", "right_hip",
    "left_knee", "right_knee", "left_ankle", "right_ankle"
  ],
  "skeleton": [
    ["left_shoulder", "left_elbow"], ["left_elbow", "left_wrist"],
    ["right_shoulder", "right_elbow"], ["right_elbow", "right_wrist"],
    ["left_hip", "left_knee"], ["left_knee", "left_ankle"],
    ["right_hip", "right_knee"], ["right_knee", "right_ankle"],
    ["left_shoulder", "right_shoulder"], ["left_hip", "right_hip"],
    ["left_shoulder", "left_hip"], ["right_shoulder", "right_hip"]
  ],
  "golf_angles": {
    "lead_arm": ["left_elbow", "left_shoulder", "left_wrist"],
    "trail_arm": ["right_elbow", "right_shoulder", "right_wrist"],
    "lead_knee_flex": ["left_knee", "left_hip", "left_ankle"],
    "spine_tilt": ["left_hip", "left_shoulder", "right_hip"],
    "hip_hinge": ["left_hip", "left_shoulder", "left_knee"]
  },
  "handedness_note": "Angles above assume a right-handed golfer (lead = left side). Swap left/right for a left-handed golfer."
}
